# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored; this example file is safe to commit.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL. Used for metadata/canonical URLs and auth redirects.
# Local: http://localhost:3000 — Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
